# Application Environment
ENVIRONMENT=development
APP_NAME="E-Commerce Abandoned Cart Recovery & Attribution System"
DEBUG=True

# Database Configuration
# Default to SQLite for zero-config portable run; Set to MySQL for production:
DATABASE_URL=sqlite:///./cart_recovery.db
# MySQL Example:
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/cart_recovery

# Business Engine Configuration
ABANDONMENT_INACTIVITY_MINUTES=60
ATTRIBUTION_WINDOW_DAYS=7
FREQUENCY_CAP_MAX_SENDS=3
FREQUENCY_CAP_WINDOW_DAYS=7

# Synthetic Generator Configuration
DEFAULT_SEED=20261022
STARTER_CARTS=2000
FULL_CARTS=50000

# Exports Directory
EXPORTS_DIR=./data/exports
REPORTS_DIR=./data/reports
MANIFESTS_DIR=./data/manifests
